# LLM：任意 OpenAI 兼容端点（中转站 / 官方直连均可，换模型零改码）
OPENAI_BASE_URL=https://your-endpoint.example/v1
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=glm-5.3-flash

# 京东联盟开放 API（可选：不配置则用 seeded mock 目录，接口完全同构）
# 入驻：https://union.jd.com → 开放平台创建应用 → 申请 jd.union.open.goods.query 权限
JD_UNION_APP_KEY=
JD_UNION_SECRET_KEY=

# Embedding 模型下载源（默认 HuggingFace 官方；被墙时改 https://hf-mirror.com）
HF_ENDPOINT=https://huggingface.co
